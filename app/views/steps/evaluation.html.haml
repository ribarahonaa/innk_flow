- content_for :title, @step.name
= render "steps/header", step: @step, handler: @handler
= render "shared/ai_suggestions", suggestions: @pending_suggestions

- progress = @handler.progress
.card
  .step-progress
    %div
      %strong= progress.done
      %span.muted= " de #{progress.total} #{progress.label} · mínimo #{@handler.min_assessments} por idea"
    .progress-bar
      .progress-bar__fill{ style: "width: #{[progress.pct, 100].min}%" }

.card
  .section-head
    %h2.section-title
      Criterios
      - if @step.criteria_set
        %span.muted= " · #{@step.criteria_set.name}"
    -# Un set inline es de ESTE módulo y se edita en su pantalla; uno de la
    -# biblioteca lo comparten otros desafíos y se edita en el mantenedor.
    - if policy(@challenge).update_pipeline?
      - if @step.criteria_set&.inline?
        = link_to "Ver los criterios", challenge_step_criteria_path(@challenge, @step), class: "btn btn--ghost btn--sm"
      - elsif @step.criteria_set
        = link_to "Ver el set", edit_criteria_set_path(@step.criteria_set), class: "btn btn--ghost btn--sm"
      - else
        = link_to "Definir los criterios", challenge_step_criteria_path(@challenge, @step), class: "btn btn--ghost btn--sm"

  - if @handler.criteria_snapshot.empty?
    %p.muted
      Este módulo todavía no tiene criterios. Se le crean tres genéricos al activarlo, o podés
      = succeed "." do
        = link_to "definirlos ahora", challenge_step_criteria_path(@challenge, @step)
  - else
    %p.muted.field-hint
      Congelados al activar el módulo: editar el set ahora no altera lo ya evaluado.
      - if @step.criteria_set&.inline?
        Este set es propio de este módulo.
    %table.step-table
      %thead
        %tr
          %th Criterio
          %th Escala
          %th Peso
      %tbody
        - @handler.criteria_snapshot.each do |criterion|
          %tr
            %td
              %strong= criterion["name"]
              - if criterion["scale_type"] == "formula"
                %span.derived-chip derivado
                %code.formula-code= criterion.dig("scale_config", "expression")
            %td.muted= t("flow.scale_types.#{criterion['scale_type']}")
            %td.muted= "#{(criterion['weight'].to_f * 100).round}%"

= render "steps/ai_mode", step: @step

-# Quién evalúa y cuánto pesa su voto. La tabla y la columna `weight` existían
-# desde el principio; no había dónde tocarlas.
- if policy(@step).manage_assignments?
  - asignaciones = @step.step_assignments.includes(:user).sort_by { |a| a.user.name }
  - evaluaron = @step.assessments.current.group(:evaluator_id).count
  - hay_pesos = asignaciones.any?(&:weighted?)
  - cerrado = @step.completed? || @step.skipped?
  .card
    .section-head
      %h2.section-title
        Quién evalúa
        %span.muted= " · #{Flow::Texto.contar(asignaciones.size, "persona")}"
      - if hay_pesos
        %span.status-chip.status-chip--active con pesos
    %p.muted.field-hint
      - if cerrado
        El módulo cerró: quién evaluó y cuánto pesó cada voto queda como está.
      - else
        Todas las voces pesan igual salvo que le pongas un peso distinto a alguna. Un peso
        de 2 hace que esa nota cuente el doble que una de peso 1.
        - unless @step.touched?
          %br
          Si asignás a alguien antes de arrancar, el módulo respeta esa lista en vez de
          repartirlo entre todos los que evalúan en la empresa.

    - if asignaciones.empty?
      %p.muted Todavía no hay nadie asignado. Se asignan solos al activar el módulo.
    - else
      %ul.field-list
        - asignaciones.each do |asignacion|
          - notas = evaluaron[asignacion.user_id].to_i
          %li.field-list__item.assignment-row
            %span
              = asignacion.user.name
              - if notas.positive?
                %span.muted= " · #{Flow::Texto.contar(notas, "evaluación")}"
              - else
                %span.muted · sin evaluar
            - unless cerrado
              .assignment-row__actions
                = form_with url: challenge_step_step_assignment_path(@challenge, @step, asignacion),
                            method: :patch, class: "assignment-weight" do
                  = label_tag "peso_#{asignacion.id}", "Peso", class: "assignment-weight__label"
                  = number_field_tag :weight, asignacion.weight&.to_f, step: 0.1, min: 0.1,
                                     max: StepAssignment::MAX_WEIGHT, id: "peso_#{asignacion.id}",
                                     placeholder: "1", class: "assignment-weight__input"
                  = submit_tag "Guardar", class: "btn btn--ghost btn--sm"
                -# Quien ya evaluó no se desasigna: su nota está puesta.
                - if notas.zero?
                  = button_to "Quitar", challenge_step_step_assignment_path(@challenge, @step, asignacion),
                              method: :delete, class: "btn btn--ghost btn--sm",
                              form: { data: { turbo_confirm: "¿Sacar a #{asignacion.user.name} de este módulo?" } }

    - if !cerrado && @assignable.any?
      = form_with url: challenge_step_step_assignments_path(@challenge, @step), method: :post,
                  class: "assignment-add" do
        = select_tag :user_id, options_from_collection_for_select(@assignable, :id, :name),
                     include_blank: "Sumar a alguien…"
        = number_field_tag :weight, nil, step: 0.1, min: 0.1, max: StepAssignment::MAX_WEIGHT,
                           placeholder: "Peso (opcional)", class: "assignment-weight__input"
        = submit_tag "Asignar", class: "btn btn--ghost btn--sm"

- manda = policy(@challenge).update_pipeline?
- pendientes = @step.step_entries.reject { |e| @handler.complete?(e) }
- if @step.active? && @step.effective_ai_mode != "human" && pendientes.any? && policy(@challenge).update_pipeline?
  .card
    %h2.section-title Pedirle una evaluación a la IA
    %p.muted
      La IA evalúa con los mismos criterios y su nota entra al promedio como una más, con su
      justificación por criterio.
    = render "shared/ai_actions", challenge: @challenge, mode: @step.effective_ai_mode,
             actions: pendientes.first(1).map { |e| { label: "Evaluar «#{e.idea.title.truncate(28)}»", purpose: "evaluate_idea", step_id: @step.id, idea_id: e.idea_id } }
    - if pendientes.size > 1
      %p.field-hint= "Quedan #{pendientes.size} ideas sin la cantidad mínima de evaluaciones."

.card
  %h2.section-title Ideas a evaluar
  - unless manda
    %p.muted.field-hint
      Los puntajes se muestran cuando envíes tu evaluación: verlos antes ancla el juicio. De las
      ideas que no evalúes vas a ver el resultado, no quién puso qué.
  - if @step.step_entries.empty?
    %p.muted Todavía no hay ideas en este módulo.
  - else
    %table.step-table
      %thead
        %tr
          %th Idea
          %th Evaluaciones
          %th Puntaje
          %th Dispersión
          %th
      %tbody
        - @step.step_entries.includes(idea: %i[current_version author idea_contributors]).each do |entry|
          - result = entry.result
          - propia = entry.idea.participates?(current_user)
          -# El puntaje agregado y el desglose por evaluador son dos cosas
          -# distintas: el autor ve el suyo, pero no quién puso qué.
          - visible = @handler.score_visible_for?(entry.idea, user: current_user, manager: manda)
          - desglose = @handler.breakdown_visible_for?(entry.idea_id, user: current_user, manager: manda)
          %tr
            %td
              = link_to entry.idea.title, challenge_idea_path(@challenge, entry.idea), class: "step-table__link"
              %span.muted= " · #{entry.idea.author.name}"
            %td.muted
              = "#{result['assessments_count'] || 0} / #{@handler.min_assessments_for(entry.idea)}"
              - evaluadores = desglose ? @handler.assessments_for(entry.idea_id) : []
              - if evaluadores.any?
                %span.evaluators
                  - evaluadores.each do |assessment|
                    %span.evaluator-chip{ class: ("evaluator-chip--ai" if assessment.by_ai?),
                                          title: "#{assessment.evaluator_name}: #{assessment.overall_comment}" }
                      = assessment.by_ai? ? "IA" : assessment.evaluator_name.split.map(&:first).join
            %td
              - if !visible
                %span.muted{ title: "Se muestra cuando envíes la tuya" } oculto
              - elsif result["score"]
                %strong= "#{(result['score'].to_f * 100).round}%"
              - else
                %span.muted —
            %td.muted= visible && result["dispersion"] ? result["dispersion"].to_f.round(3) : "—"
            %td.nowrap
              - if @step.active? && propia
                %span.field-hint Es tu idea
              - elsif @step.active?
                = link_to "Evaluar", new_challenge_step_assessment_path(@challenge, @step, idea_id: entry.idea_id), class: "btn btn--ghost btn--sm"
                - if @step.effective_ai_mode != "human" && manda
                  = button_to "IA", challenge_ai_requests_path(@challenge, purpose: "evaluate_idea", step_id: @step.id, idea_id: entry.idea_id),
                              class: "btn btn--ghost btn--sm", title: "Que la IA evalúe esta idea"

- hechas = @step.assessments.current.submitted_ones.includes(:idea, :evaluator, :assessment_scores).to_a
-# Idem: solo se ven las de las ideas que ya evaluaste.
- hechas = hechas.select { |a| @handler.breakdown_visible_for?(a.idea_id, user: current_user, manager: manda) }
- if hechas.any?
  .card
    %h2.section-title
      Evaluaciones hechas
      %span.muted= " (#{hechas.size})"
    %p.muted.field-hint
      Las de la IA cuentan igual que las de una persona: mismo peso en el promedio.
      - unless manda
        Solo ves las de las ideas que ya evaluaste.
    - hechas.group_by(&:idea).each do |idea, lista|
      .assessment-group
        %h3.assessment-group__title
          = link_to idea.title, challenge_idea_path(@challenge, idea), class: "step-table__link"
        - lista.each do |assessment|
          .assessment-detail{ class: ("assessment-detail--ai" if assessment.by_ai?) }
            .assessment-detail__head
              %strong= assessment.evaluator_name
              - if assessment.by_ai?
                %span.ai-chip IA
              %span.version-chip= assessment.idea_version.label
              - if assessment.stale?
                %span.stale-chip= "la idea ya va por #{idea.current_version&.label}"
              - if assessment.normalized_score
                %span.assessment-detail__score= "#{(assessment.normalized_score.to_f * 100).round(1)}%"
            - if assessment.overall_comment.present?
              %p.assessment-detail__comment= assessment.overall_comment
            %ul.assessment-detail__scores
              - assessment.assessment_scores.sort_by { |s| s.criterion_key }.each do |score|
                %li
                  %span.assessment-detail__criterion= score.criterion_key
                  %strong= score.display_value
                  - if score.comment.present?
                    %span.muted= score.comment
                  - if score.error.present?
                    %span.stale-chip= score.error
