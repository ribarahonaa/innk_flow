- content_for :title, @step.name
= render "steps/header", step: @step, handler: @handler
= render "shared/ai_suggestions", suggestions: @pending_suggestions

= render "steps/ai_mode", step: @step

- progress = @handler.progress
.card
  .step-progress
    %div
      %strong= progress.done
      %span.muted= " de #{progress.total} #{progress.label}"
    .progress-bar
      .progress-bar__fill{ style: "width: #{[progress.pct, 100].min}%" }
  = render "shared/ai_actions", challenge: @challenge, mode: @step.effective_ai_mode,
           actions: @step.step_entries.first(1).map { |e| { label: "Sugerir feedback con IA", purpose: "suggest_feedback", step_id: @step.id, idea_id: e.idea_id } }

.feedback-board
  - @step.step_entries.includes(idea: %i[current_version author]).each do |entry|
    - items = @handler.feedback_for(entry.idea_id)
    - open_items = items.reject(&:addressed)
    .card.feedback-card
      .feedback-card__head
        %div
          = link_to entry.idea.title, challenge_idea_path(@challenge, entry.idea), class: "feedback-card__title"
          %p.muted
            = entry.idea.author.name
            %span.version-chip= entry.idea.current_version&.label
        .feedback-card__state
          - if @handler.responded?(entry)
            %span.status-chip.status-chip--completed actualizada
          - elsif open_items.any?
            %span.status-chip.status-chip--pending= "#{open_items.size} sin atender"
          - if @step.active? && policy(entry.idea).update?
            = link_to "Responder editando la idea",
                      edit_challenge_idea_path(@challenge, entry.idea),
                      class: "btn btn--primary btn--sm"

      - if items.any?
        %ul.feedback-list
          - items.each do |item|
            %li.feedback-item{ class: ("is-addressed" unless item.open?) }
              .feedback-item__head
                %span.feedback-kind{ class: "feedback-kind--#{item.kind}" }= item.kind_label
                %span.muted= item.author_name
                - if item.by_ai?
                  %span.ai-chip IA
                - if item.open? && item.stale?
                  %span.muted= "· sobre #{item.idea_version.label}, la idea ya cambió"
              %p.feedback-item__body= item.body

              - if item.open?
                - if @step.active? && policy(item).resolve?
                  = form_with url: resolve_challenge_step_feedback_item_path(@challenge, @step, item), method: :post, class: "feedback-resolve" do
                    = text_field_tag :note, nil, placeholder: "Nota de cierre (opcional)", class: "feedback-resolve__note"
                    -# button_tag y no submit_tag: en un <input type="submit"> el
                    -# texto visible ES el value, así que no se puede mandar
                    -# "acknowledged" y mostrar "Tomado en cuenta".
                    = button_tag "Tomado en cuenta", type: "submit", name: "resolution",
                                 value: "acknowledged", class: "btn btn--ghost btn--sm"
                    = button_tag "No aplica", type: "submit", name: "resolution",
                                 value: "dismissed", class: "btn btn--ghost btn--sm"
              - else
                .feedback-item__resolution
                  %span.status-chip.status-chip--completed= item.resolution_label
                  - if item.addressed_by_version
                    %span.muted= "en #{item.addressed_by_version.label}"
                  - if item.resolved_by
                    %span.muted= "· #{item.resolved_by_name}"
                  - if item.resolution_note.present?
                    %span.muted= "· #{item.resolution_note}"
                  - if @step.active? && policy(item).resolve?
                    = button_to "Reabrir", reopen_challenge_step_feedback_item_path(@challenge, @step, item),
                                class: "link-button"
      - else
        %p.muted Todavía nadie dio feedback a esta idea.

      - if @step.active?
        = form_with url: challenge_step_feedback_items_path(@challenge, @step, idea_id: entry.idea_id), method: :post, class: "feedback-form" do
          = select_tag :kind, options_for_select(FeedbackItem::KINDS.map { |k| [t("flow.feedback_kinds.#{k}"), k] }), class: "feedback-form__kind"
          = text_field_tag :body, nil, placeholder: "Qué le falta o qué mejorarías", required: true
          = submit_tag "Comentar", class: "btn btn--ghost btn--sm"
