-# Cabecera de la cara de configuración. La de ejecución es `steps/_header`:
-# son dos cosas distintas y compartir una las volvía condicional adentro.
.page-head
  %div
    %p.breadcrumb
      = link_to "Desafíos", challenges_path
      = " › "
      = link_to step.challenge.name, challenge_path(step.challenge)
      -# El builder es `ChallengePolicy#builder?` (= `administra?`, que cubre
      -# a quien administra la empresa y al gestor asignado): sin esta guarda,
      -# quien participa o evalúa recibía un link que le rebota en 403 al
      -# clickearlo — el mismo control-que-no-responde del CRITICAL.
      - if policy(step.challenge).builder?
        = " › "
        = link_to "Flujo", builder_challenge_path(step.challenge)
    %h1.page-title= step.name
    %p.muted
      %span{ class: chip_de_estado(step.status) }= t("flow.statuses.#{step.status}")
      %span= " · #{t("flow.kinds.#{step.kind}")}"
      -# Quien no configura recibe esta misma pantalla en modo lectura, así que
      -# el imperativo le nombraba algo que no puede hacer. La cara es la misma;
      -# lo que cambia es qué se puede hacer con ella.
      - if policy(step).configure?
        %span  · configurá cómo va a funcionar antes de que arranque
      - else
        %span  · así va a funcionar cuando arranque
