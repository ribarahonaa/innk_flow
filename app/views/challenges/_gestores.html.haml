-# Quiénes acompañan la evolución de las ideas de este desafío.
-#
-# Un gestor tiene membresía en la empresa pero NO ve sus desafíos: se lo asigna
-# acá, uno por uno. Es lo que permite que la misma persona acompañe a varias
-# empresas sin que se le mezcle nada.
-#
-# En la ficha del desafío y en la cara de configuración es una tarjeta; en
-# los ajustes del módulo, una sección (`tarjeta: false`).
= render layout: "steps/bloque", locals: { tarjeta: local_assigns.fetch(:tarjeta, true) } do
  .section-head
    %div
      %h2.section-title Quiénes acompañan
      %p.muted Administran este desafío: lo configuran, lo hacen avanzar y trabajan sus ideas. No postulan ideas propias.
      -# Se configura acá porque es donde un gestor tiene algo que hacer, pero
      -# el acceso es al DESAFÍO: sin decirlo, alguien asigna esperando que solo
      -# vea este módulo.
      - if local_assigns[:desde_modulo]
        %p.field-hint Se asigna por desafío, no por módulo: quien acompañe va a ver todas las ideas del desafío.
  - asignados = challenge.challenge_gestores.includes(:user)

  - if asignados.any?
    %ul.people-list
      - asignados.each do |asignacion|
        %li.people-list__item
          %span.people-list__name= asignacion.user.name
          %span.people-list__role gestor
          -# El gestor no se saca a sí mismo (`ChallengeGestoresController`), así
          -# que dibujarle el botón en su propia fila sólo ofrece un clic que
          -# termina en el `alert` de rechazo.
          - unless asignacion.user_id == current_user.id
            = button_to "×", challenge_gestor_path(challenge, asignacion), method: :delete,
                        class: "people-list__remove",
                        form: { data: { turbo_confirm: "¿Sacar a #{asignacion.user.name} de este desafío?" } }
  - else
    %p.field-hint Nadie asignado todavía: las ideas de este desafío no las acompaña ningún gestor.

  - if candidatos.any?
    = form_with url: challenge_gestores_path(challenge), method: :post, class: "people-form" do
      = select_tag :user_id, options_from_collection_for_select(candidatos, :id, :name),
                   include_blank: "Elegí a quién sumar"
      = submit_tag "Sumar", class: "btn btn-ghost btn-sm"
  - else
    %p.field-hint
      - if asignados.any?
        Ya está todo el equipo de gestores en este desafío.
      - else
        La empresa todavía no tiene a nadie con rol gestor.
