- content_for :title, "Nuevo desafío"
= render "shared/setup_outline"

.card.narrow
  %h1.page-title Nuevo desafío
  %p.muted Qué se pregunta, quién trabaja, y con qué flujo arranca. Todo se edita después.

  = form_with model: @challenge do |f|
    - if @challenge.errors.any?
      .flash.flash--alert= @challenge.errors.full_messages.to_sentence
    .field
      = f.label :name, "Nombre"
      = f.text_field :name, autofocus: true, required: true, placeholder: "Reducir la merma en bodega"
    .field
      = f.label :brief, "Brief"
      = f.text_area :brief, rows: 4, placeholder: "Qué problema se quiere resolver, para quién, y qué haría exitosa a una idea."
      %p.field-hint Este texto es lo que lee la IA cuando propone el flujo, los campos del formulario o ideas candidatas.
    .field
      = f.label :ai_default_mode, "Modo de IA por defecto"
      .radio-cards
        - Challenge::AI_MODES.each do |mode|
          %label.radio-card
            = f.radio_button :ai_default_mode, mode
            %span.radio-card__body
              %strong= t("flow.ai_modes.#{mode}")
              %span.muted= t("flow.ai_mode_descriptions.#{mode}")
      %p.field-hint Cada módulo puede sobreescribirlo.

    .field
      = f.label :template, "Cómo arrancás el flujo"
      .radio-cards
        - Flow::FlowTemplates::TEMPLATES.each do |template|
          %label.radio-card
            = radio_button_tag :template, template[:key], template[:key] == "classic"
            %span.radio-card__body
              %strong= template[:name]
              = render "challenges/template_outline", template: template
              %span.muted= template[:description]

        %label.radio-card
          = radio_button_tag :template, "ai"
          %span.radio-card__body
            %strong Que lo proponga la IA
            %span.muted La IA lee el brief y arma un flujo. Lo revisás antes de que se aplique.

        %label.radio-card
          = radio_button_tag :template, "blank"
          %span.radio-card__body
            %strong En blanco
            %span.muted Lo armás vos, módulo por módulo.
      %p.field-hint Cualquiera de estos flujos se edita entero después: la plantilla es un punto de partida, no un molde.

    .form-actions
      = link_to "Cancelar", challenges_path, class: "btn btn--ghost"
      = f.submit "Crear y armar el flujo", class: "btn btn--primary"
