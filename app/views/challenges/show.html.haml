- content_for :title, @challenge.name
.page-head
  %div
    %p.breadcrumb= link_to "Desafíos", challenges_path
    %h1.page-title= @challenge.name
    %p.muted
      %span{ class: chip_de_estado(@challenge.status) }= t("flow.challenge_statuses.#{@challenge.status}")
      %span= " · modo IA: #{t("flow.ai_modes.#{@challenge.ai_default_mode}")}"
  .page-head__actions
    -# Con el desafío en curso, lo que se viene a hacer acá es mirar las ideas.
    = link_to "Ideas", challenge_ideas_path(@challenge),
              class: ["btn", (@challenge.draft? ? "btn-ghost" : "btn-primary")]
    - if policy(@challenge).builder?
      = link_to "Previsualizar", challenge_preview_path(@challenge), class: "btn btn-ghost"
      = link_to "Editar flujo", builder_challenge_path(@challenge), class: "btn btn-ghost"
    - if policy(@challenge).start?
      = button_to "Arrancar", start_challenge_path(@challenge), class: "btn btn-primary"

-# En borrador la ficha del desafío es el punto de partida: ahí va el camino.
- if @challenge.draft? && policy(@challenge).builder?
  = render "shared/setup_nav", challenge: @challenge

= render "shared/ai_suggestions", suggestions: @pending_suggestions

- if @challenge.brief.present?
  .panel
    %h2.section-title Brief
    %p= simple_format(@challenge.brief)

- hechos = @challenge.steps.count { |s| %w[completed skipped].include?(s.status) }
- actual = @challenge.steps.find(&:active?)
.panel
  .section-head
    %h2.section-title Flujo
    -# Dónde está el proceso, sin tener que leer la tabla fila por fila.
    %span.muted
      - if @challenge.draft?
        = "#{Flow::Texto.contar(@challenge.steps.size, 'módulo')} · sin arrancar"
      - elsif actual
        = "#{hechos} de #{@challenge.steps.size} · ahora: #{actual.name}"
      - else
        = "#{hechos} de #{@challenge.steps.size} · flujo terminado"
  = render "challenges/flow_strip", challenge: @challenge

  - if @report.errors.any?
    .alert.alert-soft.alert-error
      %div
        %strong Falta resolver:
        %ul
          - @report.errors.each do |error|
            %li= error
  - if @report.warnings.any?
    .alert.alert-soft.alert-warning
      %ul
        - @report.warnings.each do |warning|
          %li= warning

  -# La columna solo aparece si alguien la usa: siete guiones en fila no son
  -# información, son ruido con encabezado.
  - encadenados = @challenge.steps.any?(&:source_step)
  %table.table
    %thead
      %tr
        %th #
        %th Módulo
        %th Estado
        %th Modo IA
        - if encadenados
          %th Toma insumo de
    %tbody
      - @challenge.steps.each_with_index do |step, index|
        %tr{ class: step.active? ? "is-active" : ("is-touched" if step.touched?) }
          %td.muted= index + 1
          %td
            = link_to challenge_step_path(@challenge, step), class: "table-link" do
              %strong= step.name
            %span.muted= " (#{t("flow.kinds.#{step.kind}")})"
            - if step.active?
              %span.here-chip acá está el flujo
          %td
            %span{ class: chip_de_estado(step.status) }= t("flow.statuses.#{step.status}")
          %td.muted= t("flow.ai_modes.#{step.effective_ai_mode}")
          - if encadenados
            %td.muted= step.source_step&.name || "—"

-# Los gestores se configuran en el módulo de evolución. Acá aparecen SOLO si
-# quedaron sin módulo donde administrarlos —alguien lo borró después de
-# asignarlos—, para que no queden inalcanzables.
- huerfanos = @challenge.challenge_gestores.any? && @challenge.steps.none?(&:evolution?)
- if huerfanos && policy(@challenge).update_pipeline?
  = render "challenges/gestores", challenge: @challenge, candidatos: @gestor_candidates
