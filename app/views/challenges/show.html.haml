- content_for :title, @challenge.name
-# El módulo en curso, si hay alguno. Se lee arriba de todo porque lo miran dos
-# cosas: el aviso del control de cerrar —que nombra el módulo que va a quedar
-# salteado— y el encabezado de la tarjeta «Flujo».
- actual = @challenge.steps.find(&:active?)
.page-head
  %div
    %p.breadcrumb= link_to "Desafíos", challenges_path
    %h1.page-title= @challenge.name
    %p.muted
      %span{ class: chip_de_estado(@challenge.status) }= t("flow.challenge_statuses.#{@challenge.status}")
      %span= " · modo IA: #{t("flow.ai_modes.#{@challenge.ai_default_mode}")}"
  .page-head__actions
    -# Con el desafío en curso, lo que se viene a hacer acá es mirar las ideas.
    = link_to "Ideas", challenge_ideas_path(@challenge),
              class: ["btn", (@challenge.draft? ? "btn-ghost" : "btn-primary")]
    - if policy(@challenge).builder?
      = link_to "Previsualizar", challenge_preview_path(@challenge), class: "btn btn-ghost"
      = link_to "Editar flujo", builder_challenge_path(@challenge), class: "btn btn-ghost"
    - if policy(@challenge).start?
      = button_to "Arrancar", start_challenge_path(@challenge), class: "btn btn-primary"
    -# Cerrar a mano, con el flujo donde esté. Acá y no en la pantalla de un
    -# módulo: es del desafío entero.
    -#
    -# Acá la policy SÍ alcanza para decidir si mostrarlo —`close?` es
    -# `administers?(record) && record.running?`, o sea que ya trae el estado—,
    -# al revés de `skip?`. Es el mismo predicado que autoriza el POST, así que
    -# el botón no puede aparecer donde va a rebotar.
    -#
    -# El aviso nombra lo que se pierde y no pregunta «¿estás seguro?»:
    -# `Pipeline#close!` saltea el módulo en curso —no lo completa— y los
    -# pendientes se quedan sin ejecutar. No hay ruta para reabrir.
    - if policy(@challenge).close?
      - por_correr = @challenge.steps.count(&:pending?)
      - detalle = []
      - detalle << "«#{actual.name}» salteado sin terminar" if actual
      - detalle << "#{Flow::Texto.contar(por_correr, 'módulo')} sin ejecutar" if por_correr.positive?
      - que_pasa = detalle.any? ? "Con eso #{Flow::Texto.agree(detalle.size, 'queda', 'quedan')} #{detalle.to_sentence}. " : ""
      = button_to "Cerrar el desafío", close_challenge_path(@challenge), class: "btn btn-ghost",
                  form: { data: { turbo_confirm: "¿Cerrar «#{@challenge.name}»? #{que_pasa}Un desafío cerrado no se reabre." } }

-# En borrador la ficha del desafío es el punto de partida: ahí va el camino.
- if @challenge.draft? && policy(@challenge).builder?
  = render "shared/setup_nav", challenge: @challenge

= render "shared/ai_suggestions", suggestions: @pending_suggestions

- if @challenge.brief.present?
  .card
    .card-body
      %h2.section-title Brief
      %p= simple_format(@challenge.brief)

.card
  .card-body
    .section-head
      %h2.section-title Flujo
      -# Dónde está el proceso, sin tener que leer la tabla fila por fila.
      -#
      -# Es una POSICIÓN y no un conteo. Contar los módulos que quedaron atrás
      -# daba el número del módulo ANTERIOR al que corre —«6 de 7 · ahora: X»
      -# con X en el séptimo—, y ahí el 6 se lee como la posición de X. Una
      -# posición además no necesita sustantivo, que es bueno porque no hay uno
      -# honesto: lo que se contaba mezclaba completados y salteados, y
      -# «cerrado» ya es el rótulo del desafío `closed`, que se lee más arriba
      -# en esta misma pantalla.
      %span.muted
        - if @challenge.draft?
          = "#{Flow::Texto.contar(@challenge.steps.size, 'módulo')} · sin arrancar"
        - elsif @challenge.closed? || @challenge.archived?
          -# Va ANTES que `actual`: `Pipeline#close!` cierra el desafío sin
          -# tocar los pasos, así que uno cerrado se queda con su módulo en
          -# curso y esto decía «ahora: X» dos centímetros abajo del chip que
          -# dice «Cerrado». La pregunta es si el flujo TERMINÓ, y eso lo
          -# contesta el desafío, no la ausencia de un módulo activo.
          = "flujo terminado"
        - elsif actual
          = "ahora: #{actual.name} · módulo #{@challenge.steps.index(actual) + 1} de #{@challenge.steps.size}"
        - else
          -# Desde que la rama del desafío cerrado va adelante, acá sólo llega
          -# un desafío EN CURSO sin ningún módulo activo, o sea un flujo
          -# trabado: completar el último cierra el desafío —`advance!` activa
          -# el siguiente pendiente o cierra, en la misma transacción— y
          -# entonces cae en la rama de arriba. Decirle «terminado» a esto
          -# sería mentir.
          = "ningún módulo en curso"
    = render "challenges/flow_strip", challenge: @challenge

    - if @report.errors.any?
      .alert.alert-soft.alert-error
        %div
          %strong Falta resolver:
          %ul
            - @report.errors.each do |error|
              %li= error
    - if @report.warnings.any?
      .alert.alert-soft.alert-warning
        %ul
          - @report.warnings.each do |warning|
            %li= warning

    -# La columna solo aparece si alguien la usa: siete guiones en fila no son
    -# información, son ruido con encabezado.
    - encadenados = @challenge.steps.any?(&:source_step)
    %table.table
      %thead
        %tr
          %th #
          %th Módulo
          %th Estado
          %th Modo IA
          - if encadenados
            %th Toma insumo de
      %tbody
        - @challenge.steps.each_with_index do |step, index|
          %tr{ class: step.active? ? "is-active" : ("is-touched" if step.touched?) }
            %td.muted= index + 1
            %td
              = link_to challenge_step_path(@challenge, step), class: "table-link" do
                %strong= step.name
              %span.muted= " (#{t("flow.kinds.#{step.kind}")})"
              - if step.active?
                %span{ class: chip("aca") } acá está el flujo
            %td
              %span{ class: chip_de_estado(step.status) }= t("flow.statuses.#{step.status}")
            %td.muted= t("flow.ai_modes.#{step.effective_ai_mode}")
            - if encadenados
              %td.muted= step.source_step&.name || "—"

-# Los gestores se configuran en el módulo de evolución. Acá aparecen SOLO si
-# quedaron sin módulo donde administrarlos —alguien lo borró después de
-# asignarlos—, para que no queden inalcanzables.
- huerfanos = @challenge.challenge_gestores.any? && @challenge.steps.none?(&:evolution?)
- if huerfanos && policy(@challenge).update_pipeline?
  = render "challenges/gestores", challenge: @challenge, candidatos: @gestor_candidates
