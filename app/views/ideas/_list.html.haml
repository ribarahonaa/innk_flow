- if ideas.empty?
  %p.muted Todavía no hay ideas.
- else
  %ul.idea-list
    - ideas.each do |idea|
      %li.idea-list__item
        = link_to challenge_idea_path(challenge, idea), class: "idea-list__link" do
          %span.idea-list__title= idea.title
          %span.idea-list__meta
            = idea.author.name
            %span.version-chip= idea.current_version&.label
            - if idea.origin == "ai"
              %span{ class: chip_de_ia } IA
        -# «No avanzó» sin decir dónde obliga a entrar a la idea para saberlo.
        %span.idea-list__outcome
          %span{ class: chip_de_estado({ "active" => "active", "eliminated" => "skipped" }.fetch(idea.status, "pending")) }
            = t("flow.idea_statuses.#{idea.status}")
          - if idea.eliminated? && idea.eliminated_at_step
            %span.muted.idea-list__where= idea.eliminated_at_step.name
