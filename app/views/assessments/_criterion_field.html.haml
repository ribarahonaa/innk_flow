-# Un criterio dentro de la ficha de evaluación.
-#
-# Vive como parcial porque la previsualización del builder lo renderiza tal
-# cual: un preview que reimplementa la ficha se desincroniza y termina
-# mostrando algo que no es lo que va a ver quien evalúa.
-#
-# `criterion` es el hash del snapshot (o del set, con la misma forma).
- record = local_assigns[:record]
- scale = record&.scale
- value_now = local_assigns[:value_now]
- ai_score = local_assigns[:ai_score]

.criterion-field
  .criterion-field__head
    %label{ for: "scores_#{criterion['key']}" }
      = criterion["name"]
      %span.criterion-field__weight= "#{(criterion['weight'].to_f * 100).round}%"
  - if criterion["description"].present?
    %p.field-hint= criterion["description"]

  - if scale.nil?
    %p.field-hint Criterio sin escala resoluble.
  - else
    - case criterion["scale_type"]
    - when "numeric"
      .scale-radios
        - scale.options.each do |value|
          - suggested = ai_score&.raw_value.to_s == value.to_s
          %label.scale-radio{ class: ("scale-radio--suggested" if suggested),
                              title: (suggested ? "La IA pondría #{value}" : nil) }
            = radio_button_tag "scores[#{criterion['key']}]", value, value_now == value.to_s, id: "scores_#{criterion['key']}_#{value}"
            %span= value
      %p.field-hint
        = scale.lower_better? ? "Menos es mejor." : "Más es mejor."
    - when "letter", "rubric", "boolean"
      .scale-options
        - scale.options.each do |label, value|
          - suggested = ai_score&.raw_value.to_s == value.to_s
          %label.scale-option{ class: ("scale-option--suggested" if suggested) }
            = radio_button_tag "scores[#{criterion['key']}]", value, value_now == value.to_s
            %span= label
            - if suggested
              %span.ai-mark IA
    - else
      = text_field_tag "scores[#{criterion['key']}]", value_now

  -# La sugerencia va PEGADA al criterio, no en un bloque aparte que haya que
  -# copiar a mano. Es lo que la vuelve una guía y no una opinión suelta.
  - if ai_score
    .ai-hint
      %span{ class: chip_de_ia } IA
      %strong.ai-hint__value= ai_score.display_value
      - if ai_score.comment.present?
        %span.ai-hint__reason= ai_score.comment

  = text_field_tag "comments[#{criterion['key']}]", local_assigns[:comment], placeholder: "Comentario (opcional)", class: "criterion-field__comment"
