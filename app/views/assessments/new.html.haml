- content_for :title, "Evaluar · #{@idea.title}"
.page-head
  %div
    %p.breadcrumb
      = link_to @challenge.name, challenge_path(@challenge)
      = " › "
      = link_to @step.name, challenge_step_path(@challenge, @step)
    %h1.page-title= @idea.title
    %p.muted
      = "Evaluando la versión "
      %span.version-chip= @idea.current_version&.label

.idea-layout
  .idea-layout__main
    - if @ai_scores.any? && !@prefill
      .card.ai-guide-banner
        %h2.section-title
          La IA ya evaluó esta idea
          %span.ai-chip IA
        %p.muted Vas a ver su valor y su razón junto a cada criterio. Podés partir de ahí y ajustar.
        = link_to "Precargar con los valores de la IA",
                  new_challenge_step_assessment_path(@challenge, @step, idea_id: @idea.id, prefill: "ai"),
                  class: "btn btn-ghost btn-sm"

    .card
      %h2.section-title Ficha de evaluación
      - if @prefill
        .flash.flash--warn
          Precargado con los valores de la IA. Revisá cada criterio antes de guardar: la evaluación queda a tu nombre.
      = form_with url: challenge_step_assessments_path(@challenge, @step), method: :post do
        = hidden_field_tag :idea_id, @idea.id

        - @handler.scored_criteria.each do |criterion|
          - record = Criterion.find_by(id: criterion["id"])
          - existing = @assessment.assessment_scores.detect { |s| s.criterion_key == criterion["key"] }
          - ai_score = @ai_scores[criterion["key"]]
          - value_now = existing&.raw_value
          - value_now = ai_score&.raw_value if @prefill && value_now.blank?
          = render "assessments/criterion_field", criterion: criterion, record: record,
                   value_now: value_now, ai_score: ai_score, comment: existing&.comment

        - derived = @handler.criteria_snapshot.select { _1["scale_type"] == "formula" }
        - if derived.any?
          .flash.flash--warn
            %strong Criterios derivados:
            = derived.map { _1["name"] }.join(", ")
            se calculan solos al guardar, a partir de los anteriores.

        .field
          = label_tag :overall_comment, "Comentario general"
          = text_area_tag :overall_comment, @assessment.overall_comment, rows: 3

        .form-actions
          = link_to "Cancelar", challenge_step_path(@challenge, @step), class: "btn btn-ghost"
          = submit_tag "Guardar evaluación", class: "btn btn-primary"

  %aside.idea-layout__side
    -# Quién puede pedirlo no es quien administra: lo autoriza
    -# `AssessmentPolicy#create?`, porque `evaluate_idea` declara
    -# `actua_sobre = :assessment`. Va SIN idea, igual que el lote de
    -# `steps/evaluation` y que `AiSuggestionPolicy#evaluacion`: pedirle a la IA
    -# que evalúe no es evaluar. Escrito a mano con `update_pipeline?`, un
    -# evaluador asignado podía pedirlo y nunca veía el botón.
    -#
    -# Hoy no puede dar `false`: el controller ya autorizó `create?` con la idea
    -# REAL, y sin idea la policy es estrictamente más permisiva —se saltea el
    -# `participates?`—. Se pregunta igual porque la vista no puede depender de
    -# lo que autorizó el controller, y va ÚLTIMO en el `&&` para que el EXISTS
    -# sobre `step_assignments` no corra cuando el bloque ni se muestra.
    - if @ai_scores.empty? && @step.effective_ai_mode != "human" && policy(Assessment.new(challenge_step: @step)).create?
      .card
        %h2.section-title ¿Querés que la IA te guíe?
        %p.muted.field-hint Evalúa con los mismos criterios y te muestra qué pondría en cada uno, con su razón.
        = button_to "Pedir la guía de la IA",
                    challenge_ai_requests_path(@challenge, purpose: "evaluate_idea", step_id: @step.id, idea_id: @idea.id),
                    class: "btn btn-ghost btn-sm btn-block"

    - if @ai_assessment&.overall_comment.present?
      .card.assessment-detail--ai
        %h2.section-title
          Comentario general de la IA
          %span.ai-chip IA
        %p.assessment-detail__comment= @ai_assessment.overall_comment

    .card
      %h2.section-title La idea
      %dl.answer-list
        - (@challenge.pipeline.ideation_step&.form_fields&.ordered || []).each do |field|
          - value = @idea.payload[field.key]
          %dt= field.label
          %dd{ class: ("is-empty" if value.blank?) }= value.presence || "—"
