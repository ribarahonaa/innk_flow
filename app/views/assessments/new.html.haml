- content_for :title, "Evaluar · #{@idea.title}"
.page-head
  %div
    %p.breadcrumb
      = link_to @challenge.name, challenge_path(@challenge)
      = " › "
      = link_to @step.name, challenge_step_path(@challenge, @step)
    %h1.page-title= @idea.title
    %p.muted
      = "Evaluando la versión "
      %span.version-chip= @idea.current_version&.label

.idea-layout
  .idea-layout__main
    .card
      %h2.section-title Ficha de evaluación
      = form_with url: challenge_step_assessments_path(@challenge, @step), method: :post do
        = hidden_field_tag :idea_id, @idea.id

        - @handler.scored_criteria.each do |criterion|
          - record = Criterion.find_by(id: criterion["id"])
          - scale = record&.scale
          - existing = @assessment.assessment_scores.detect { |s| s.criterion_key == criterion["key"] }
          .criterion-field
            .criterion-field__head
              %label{ for: "scores_#{criterion['key']}" }
                = criterion["name"]
                %span.criterion-field__weight= "#{(criterion['weight'].to_f * 100).round}%"
            - if criterion["description"].present?
              %p.field-hint= criterion["description"]

            - case criterion["scale_type"]
            - when "numeric"
              .scale-radios
                - scale.options.each do |value|
                  %label.scale-radio
                    = radio_button_tag "scores[#{criterion['key']}]", value, existing&.raw_value == value.to_s, id: "scores_#{criterion['key']}_#{value}"
                    %span= value
              %p.field-hint
                = scale.lower_better? ? "Menos es mejor." : "Más es mejor."
            - when "letter", "rubric"
              .scale-options
                - scale.options.each do |label, value|
                  %label.scale-option
                    = radio_button_tag "scores[#{criterion['key']}]", value, existing&.raw_value == value.to_s
                    %span= label
            - else
              = text_field_tag "scores[#{criterion['key']}]", existing&.raw_value

            = text_field_tag "comments[#{criterion['key']}]", existing&.comment, placeholder: "Comentario (opcional)", class: "criterion-field__comment"

        - derived = @handler.criteria_snapshot.select { _1["scale_type"] == "formula" }
        - if derived.any?
          .flash.flash--warn
            %strong Criterios derivados:
            = derived.map { _1["name"] }.join(", ")
            se calculan solos al guardar, a partir de los anteriores.

        .field
          = label_tag :overall_comment, "Comentario general"
          = text_area_tag :overall_comment, @assessment.overall_comment, rows: 3

        .form-actions
          = link_to "Cancelar", challenge_step_path(@challenge, @step), class: "btn btn--ghost"
          = submit_tag "Guardar evaluación", class: "btn btn--primary"

  %aside.idea-layout__side
    - opinion = @step.assessments.current.submitted_ones.detect { |a| a.idea_id == @idea.id && a.by_ai? }
    - if opinion
      .card.assessment-detail--ai
        %h2.section-title
          Lo que opina la IA
          %span.ai-chip IA
        %p.muted.field-hint Es una referencia. Tu evaluación es independiente.
        - if opinion.overall_comment.present?
          %p.assessment-detail__comment= opinion.overall_comment
        %ul.assessment-detail__scores
          - opinion.assessment_scores.sort_by(&:criterion_key).each do |score|
            %li
              %span.assessment-detail__criterion= score.criterion_key
              %strong= score.raw_value.presence || "—"
              - if score.comment.present?
                %span.muted= score.comment
    - elsif @step.effective_ai_mode != "human" && policy(@challenge).update_pipeline?
      .card
        %h2.section-title ¿Querés una segunda opinión?
        %p.muted.field-hint La IA evalúa con los mismos criterios y deja su justificación.
        = button_to "Pedir la opinión de la IA",
                    challenge_ai_requests_path(@challenge, purpose: "evaluate_idea", step_id: @step.id, idea_id: @idea.id),
                    class: "btn btn--ghost btn--sm btn--block"

    .card
      %h2.section-title La idea
      %dl.answer-list
        - (@challenge.pipeline.ideation_step&.form_fields&.ordered || []).each do |field|
          - value = @idea.payload[field.key]
          %dt= field.label
          %dd{ class: ("is-empty" if value.blank?) }= value.presence || "—"
