- content_for :title, "Criterios"
.page-head
  %div
    %h1.page-title Sets de criterios
    %p.muted Plantillas reusables. Al activar un módulo de evaluación, sus criterios quedan congelados ahí.
  = link_to "Nuevo set", new_criteria_set_path, class: "btn btn--primary"

- if @sets.empty?
  .card.empty-state
    %h2 Todavía no hay sets
    %p.muted Un set define con qué criterios y qué pesos se puntúan las ideas.
    = link_to "Crear el primero", new_criteria_set_path, class: "btn btn--primary"
- else
  .challenge-grid
    - @sets.each do |set|
      .card
        .challenge-card__head
          %h2.challenge-card__name= set.name
          %span.status-chip{ class: "status-chip--#{set.status == 'valid' ? 'completed' : 'skipped'}" }
            = set.status == "valid" ? "válido" : "revisar"
        %p.muted= "#{set.active_criteria.size} criterios · pesos suman #{(set.weight_total * 100).round}%"
        %ul.field-list
          - set.criteria.each do |criterion|
            %li.field-list__item
              %span
                = criterion.name
                %span.source-chip{ class: "source-chip--#{criterion.source}" }= t("flow.criterion_sources.#{criterion.source}")
              %span.field-list__type= "#{(criterion.weight.to_f * 100).round}%"
        = link_to "Editar", edit_criteria_set_path(set), class: "btn btn--ghost btn--block"
