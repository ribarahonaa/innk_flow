-# La sala de evolución de UN desafío: por cada idea que la mesa puede trabajar,
-# un formulario con el payload propuesto. Se renderiza desde `show.html.haml`,
-# detrás de `can_work`. Los formularios son hermanos, nunca anidados.
- ideation = link.challenge.pipeline.ideation_step
-# Un archivo no viaja en una propuesta: sólo campos de valor.
- all_fields = ideation ? ideation.form_fields.ordered.to_a : []
- fields = all_fields.reject { |field| field.field_type == "file" }
- file_fields = all_fields.select { |field| field.field_type == "file" }
- ideas = group ? group.workable_ideas(link.challenge).includes(:current_version).to_a : []

.card
  .card-body
    %h2.section-title= link.challenge.name
    - if group.nil?
      %p.muted Sólo se propone desde una mesa: no estás en ninguna de este taller.
    - elsif ideas.empty?
      %p.muted Ninguna persona de tu mesa tiene ideas en este desafío todavía.
    - else
      %p.muted Proponé cambios sobre las ideas de tu mesa: quien es autor decide si los acepta.
      -# Sin este aviso, un campo de archivo —sobre todo uno requerido— dejaba
      -# de ser proponible sin que la pantalla dijera por qué no está.
      - if file_fields.any?
        .alert.alert-soft.alert-warning
          %div= "#{file_fields.size == 1 ? 'El campo de archivo' : 'Los campos de archivo'} #{file_fields.map(&:label).to_sentence} no se propone desde el taller, por eso no está en el formulario."
      - ideas.each do |idea|
        %div
          %h3= idea.title
          = form_with url: workshop_sala_proposals_path(workshop, link) do
            = hidden_field_tag :idea_id, idea.id, id: "idea_id_#{idea.id}"
            = render "ideas/form_fields", fields: fields, payload: idea.payload, id_prefix: "idea_#{idea.id}_"
            = submit_tag "Proponer", class: "btn btn-primary"
