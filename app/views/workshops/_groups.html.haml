-# Las mesas del taller: armarlas y convocar gente. Se renderiza desde
-# `_assembly`, detrás del mismo `can_assemble` (calculado en `show.html.haml`
-# y reusado en toda la cadena): acá no se vuelve a preguntar el permiso.
-#
-# Convocar ES sumar a una mesa (`Flow::Workshops::Convoke`): no hay una lista
-# de convocados aparte. En modo individual, elegir a la persona alcanza — el
-# servicio le arma su propia mesa —, así que ahí no hace falta "Crear mesa" ni
-# elegir a cuál. En modo por mesas hay que decir a CUÁL, así que el alta de
-# gente vive dentro de cada mesa y "Crear mesa" se ofrece antes de poder
-# convocar a nadie.
-#
-# La lista de candidatos es toda la empresa menos quien ya está en una mesa
-# de ESTE taller: participar de un desafío vinculado no es estar convocado
-# (`WorkshopPolicy::Scope`), así que la convocatoria no se acota a eso.
- already_in_ids = WorkshopGroupMember.joins(:workshop_group).where(workshop_groups: { workshop_id: workshop.id }).select(:user_id)
-# Con el taller ABIERTO las mesas se siguen tocando, y es DELIBERADO: llegó
-# alguien tarde a la sesión y hay que moverlo de mesa. Con el taller CERRADO
-# no: borrar una mesa cascadea sus propuestas —incluidas las aceptadas— y eso
-# es puro daño. Una variable calculada UNA vez, y el controller pregunta lo
-# mismo; ofrecer los controles igual sería un control que no responde.
- can_edit = !workshop.closed?
- convocable = can_edit ? User.joins(:memberships).where(memberships: { company_id: Current.company.id }).where.not(id: already_in_ids).order(:name) : User.none

.card
  .card-body
    .section-head
      %h2.section-title
        Mesas
        %span.muted= " · #{Flow::Texto.contar(groups.size, 'mesa')}"

    -# Más angosto que el `can_edit` de alrededor a propósito: ese vive con el
    -# taller en borrador, y el reparto necesita la fase (que en borrador no
    -# existe) y ninguna propuesta hecha. Ofrecerlo con la condición ancha
    -# sería un control que rebota.
    -# En modo individual no va: ahí una mesa es una persona por diseño.
    -# Abierto no alcanza: `MaterializeClosures` cierra los vínculos vencidos y
    -# no el taller, así que puede estar abierto y sin fase.
    - puede_repartir = can_edit && workshop.open? && workshop.phase.present? && !workshop.individual? && groups.none? { |g| g.workshop_proposals.exists? }
    - if puede_repartir
      = form_with url: assign_workshop_workshop_groups_path(workshop), method: :post, class: "assignment-add" do |f|
        %div
          = f.label :size, "Personas por mesa"
          = f.number_field :size, value: 4, min: 1, max: 20
          = f.submit "Armar mesas", class: "btn btn-primary btn-sm"

    - if groups.empty?
      %p.muted Todavía no hay mesas armadas.
    - else
      %ul.field-list
        - groups.each do |group|
          %li.field-list__item
            -# `.field-list__item` es `display: flex` (una fila, con sus hijos
            -# repartidos por `justify-content: space-between`): con tres
            -# hijos sueltos —esta cabecera, la lista de integrantes y el form
            -# de convocar— quedaban lado a lado en vez de apilados. Un solo
            -# `%div` envolvente, mismo arreglo que pide CLAUDE.md para el
            -# `alert` de DaisyUI que también reparte por columnas.
            %div
              .assignment-row
                %span
                  = group.name
                  %span.muted= " · #{Flow::Texto.contar(group.workshop_group_members.size, 'persona')}"
                -# La llegada no se ofrece: es la sala de espera y se va sola
                -# cuando el reparto la vacía (`WorkshopGroupsController#destroy`
                -# la rechazaría igual).
                - if can_edit && !group.arrival?
                  .assignment-row__actions
                    -# El aviso dice a dónde va la gente. Las propuestas no
                    -# entran: con alguna, el controller rechaza el borrado, y
                    -# prometer que se borran sería un aviso falso. En modo
                    -# individual no hay mesa de llegada y se saca a la
                    -# persona, así que ahí el aviso dice eso.
                    - aviso = workshop.individual? ? "¿Eliminar esta mesa? Se saca a quien esté en ella." : "¿Eliminar esta mesa? Quien esté en ella pasa a la mesa de llegada, con su asistencia como estaba, hasta el próximo reparto."
                    = button_to "Eliminar mesa", workshop_workshop_group_path(workshop, group), method: :delete,
                                class: "btn btn-ghost btn-sm",
                                form: { data: { turbo_confirm: aviso } }

              - if group.workshop_group_members.any?
                %ul.field-list
                  -# Los ASIENTOS y no `group.members`: `attended` vive en el
                  -# asiento, y `members` es un `has_many through` que devuelve
                  -# los `User`.
                  - group.workshop_group_members.each do |seat|
                    %li.field-list__item
                      %span
                        = seat.user.name
                        - unless seat.attended
                          %span.muted= " · ausente"
                      - if can_edit
                        .assignment-row__actions
                          -# Hermanos del form de convocar y NO adentro: un
                          -# `button_to` es un `<form>`, y uno dentro de otro es
                          -# HTML inválido que el navegador aplana sin dejar
                          -# rastro en el DOM.
                          = button_to seat.attended ? "Marcar ausente" : "Marcar presente",
                                      attendance_workshop_path(workshop), method: :patch,
                                      params: { user_id: seat.user_id, attended: !seat.attended },
                                      class: "btn btn-ghost btn-sm"
                          = button_to "Sacar", dismiss_workshop_path(workshop), method: :delete,
                                      params: { user_id: seat.user_id }, class: "btn btn-ghost btn-sm"

              - if workshop.mode == "group" && convocable.any?
                -# El `id:` explícito evita ids duplicados: cada mesa repite
                -# este mismo form, y sin distinguirlos el DOM tiene tantos
                -# `#user_id` como mesas.
                = form_with url: convoke_workshop_path(workshop), method: :post, class: "assignment-add" do
                  = hidden_field_tag :workshop_group_id, group.id, id: "mesa_#{group.id}"
                  = select_tag :user_id, options_from_collection_for_select(convocable, :id, :name),
                               include_blank: "Sumar a esta mesa…", id: "convocar_#{group.id}", required: true
                  = submit_tag "Convocar", class: "btn btn-ghost btn-sm"

    - if workshop.closed?
      %p.field-hint Este taller ya cerró: las mesas quedan como están.
    - elsif workshop.mode == "group"
      = form_with url: workshop_workshop_groups_path(workshop), method: :post, class: "assignment-add" do
        = text_field_tag :name, nil, placeholder: "Nombre de la mesa (opcional)"
        = submit_tag "Crear mesa", class: "btn btn-ghost btn-sm"
    - elsif convocable.any?
      %p.field-hint Convocar arma la mesa de esa persona sola.
      = form_with url: convoke_workshop_path(workshop), method: :post, class: "assignment-add" do
        = select_tag :user_id, options_from_collection_for_select(convocable, :id, :name),
                     include_blank: "Convocar…", required: true
        = submit_tag "Convocar", class: "btn btn-ghost btn-sm"
