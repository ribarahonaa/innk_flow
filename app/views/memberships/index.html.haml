- content_for :title, "Miembros"
.page-head
  %div
    %h1.page-title Quiénes están en #{current_company.name}
    %p.muted Una persona puede estar en varias empresas: su rol acá no toca el que tenga en otra.

.panel
  %h2.section-title Sumar a alguien
  = form_with url: members_path, method: :post, class: "invite-form" do
    = email_field_tag :email, nil, placeholder: "email@empresa.com", required: true
    = text_field_tag :name, nil, placeholder: "Nombre (opcional)"
    = select_tag :role, options_for_select(Membership::ROLES.map { |r| [t("flow.roles.#{r}"), r] }, "participant")
    = submit_tag "Sumar", class: "btn btn-primary btn-sm"
  %p.field-hint
    Si la persona ya existe se le suma esta empresa; si no, se crea. Todavía no hay envío de
    invitaciones por mail: quien la crea le pasa el acceso.

.panel
  %h2.section-title
    Miembros
    %span.muted= " (#{@memberships.size})"

  %ul.member-list
    - @memberships.each do |membership|
      %li.member
        %span.member__name
          = membership.user.name
          %span.muted= " · #{membership.user.email}"
        %span.member__role
          = form_with url: member_path(membership), method: :patch, class: "member__form" do
            = select_tag :role, options_for_select(Membership::ROLES.map { |r| [t("flow.roles.#{r}"), r] }, membership.role),
                         onchange: "this.form.requestSubmit()"
            %noscript= submit_tag "Cambiar", class: "btn btn-ghost btn-sm"
        = button_to "Sacar", member_path(membership), method: :delete, class: "btn btn-ghost btn-sm",
                    form: { data: { turbo_confirm: "¿Sacar a #{membership.user.name} de #{current_company.name}?" } }

.panel
  %h2.section-title Qué hace cada rol
  %ul.field-list
    - Membership::ROLES.each do |role|
      %li.field-list__item
        %span.field-list__label= t("flow.roles.#{role}").capitalize
        %span.muted= t("flow.role_descriptions.#{role}")
