!!!
-# El tema queda fijado en claro. `flow-oscuro` existe y está medido, pero
-# DaisyUI lo engancha a `prefers-color-scheme` con `:root:not([data-theme])`:
-# mientras este atributo esté puesto, el modo oscuro NO se activa solo.
-# Sacarlo es lo único que hace falta para encenderlo.
%html{ lang: I18n.locale, "data-theme": "flow" }
  %head
    %title= content_for(:title) || "innk flow"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    -# Turbo 8: cuando un POST redirige a la MISMA pantalla —que es lo que hace
    -# casi todo acá, empezando por los pedidos a la IA— el resultado se morfea
    -# sobre el DOM que ya está en vez de repintar la página entera. Se ve como
    -# que el dato se actualizó, no como que la pantalla se recargó.
    -#
    -# `refresh-scroll: preserve` le dice a Turbo que no scrollee al tope. No
    -# alcanza para conservar el scroll —el morph lo pierde antes, ver
    -# app/javascript/application.js—, pero sin esto no hay nada que conservar.
    %meta{ name: "turbo-refresh-method", content: "morph" }
    %meta{ name: "turbo-refresh-scroll", content: "preserve" }
    = csrf_meta_tags
    = csp_meta_tag
    -# Las dos familias del carácter. `display=swap` y pila de respaldo en el
    -# tema: si Google Fonts no responde, la app se ve con la fuente del
    -# sistema y no se rompe ni se queda en blanco.
    %link{ rel: "preconnect", href: "https://fonts.googleapis.com" }
    %link{ rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "anonymous" }
    %link{ rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Inter:wght@400;500;600&display=swap" }
    = stylesheet_link_tag "application-build-css", "data-turbo-track": "reload", nonce: content_security_policy_nonce
    = javascript_include_tag "application-build", "data-turbo-track": "reload", defer: true, nonce: content_security_policy_nonce
    = yield :head
  %body
    %header.app-header
      .app-header__brand= link_to "innk flow", root_path, class: "app-header__brand-link"
      - if signed_in? && current_company
        %nav.app-nav
          = link_to "Desafíos", challenges_path,
                    class: ["app-nav__link", ("is-active" if controller_name.in?(%w[challenges steps ideas assessments]))]
          - if current_membership&.manages_challenges?
            = link_to "Criterios", criteria_sets_path,
                      class: ["app-nav__link", ("is-active" if controller_name == "criteria_sets")]
            = link_to "IA", ai_runs_path,
                      class: ["app-nav__link", ("is-active" if controller_name.start_with?("ai_"))]
            = link_to "Miembros", members_path,
                      class: ["app-nav__link", ("is-active" if controller_name == "memberships")]
      .app-header__spacer
      = yield :header_right
      - if signed_in?
        .app-header__session
          = link_to notifications_path, class: "bell", title: "Avisos" do
            %svg.bell__icon{ viewBox: "0 0 16 16", "aria-hidden": true }
              %path{ fill: "currentColor", d: "M8 1.5a3.5 3.5 0 0 0-3.5 3.5v2.2L3.3 9.4a.6.6 0 0 0 .5.9h8.4a.6.6 0 0 0 .5-.9l-1.2-2.2V5A3.5 3.5 0 0 0 8 1.5Zm0 12a1.8 1.8 0 0 0 1.7-1.2H6.3A1.8 1.8 0 0 0 8 13.5Z" }
            - count = unread_notifications
            - if count.positive?
              %span.bell__count= count > 9 ? "9+" : count
          %span.app-header__company= current_company&.name
          %span.app-header__user
            = current_user.name
            %span.app-header__role= current_membership&.role
          - if current_user.multi_company?
            = link_to "Cambiar empresa", select_company_path, class: "app-header__link"
          = button_to "Salir", logout_path, method: :delete, class: "app-header__link app-header__link--button"
    %main.app-main
      - flash.each do |type, message|
        %div{ class: clase_de_flash(type) }= message
      = yield
