-# La barra lateral con el camino del desafío. Responde «dónde estoy y qué
-# sigue», que es la pregunta que la app no contestaba en ninguna pantalla.
-#
-# Tiene DOS caras, y la decide el estado del desafío:
-#
-#   en borrador  el camino de CONFIGURAR: el desafío, el flujo, un paso por
-#                módulo con su ✓ y su pista, y «Revisar y arrancar».
-#   arrancado    el mapa de lo que está CORRIENDO: los módulos con su estado
-#                de ejecución.
-#
-# Eso estuvo repartido en dos listas —ésta y una tarjeta arriba del contenido—
-# que mostraban lo mismo con distinto vocabulario. Con siete módulos la
-# tarjeta se partía en dos filas y se comía la pantalla, así que se fue y esta
-# barra absorbió lo que ella sabía.
-#
-# Es un `menu` de DaisyUI dentro de una región propia de la grilla del shell.
-# NO es el componente `drawer`: ese pide un checkbox, dos labels y envolver el
-# contenido entero para poder superponerse. Acá abajo de 1024px el flujo pasa
-# a ser una tira horizontal arriba del contenido — sin una línea de JS y sin
-# que haya que abrir nada para saber dónde estás.
-#
-# Los enlaces llevan clase propia a propósito: `a:not([class])` de `@layer
-# base` le devuelve el subrayado del navegador al enlace pelado, y los de un
-# menú saldrían todos subrayados.
- configurando = desafio.draft? && policy(desafio).builder?
- setup = Flow::Setup.new(desafio) if configurando
- actual = paso_actual_del_setup
-# El `__panel` no es decoración: la columna oscura ocupa la fila entera
-# —si no, el flujo se ve como una tarjeta flotando en una franja gris— y lo
-# que se queda pegado al scroll es lo de adentro.
%aside.flow-drawer.bg-neutral.text-neutral-content
  .flow-drawer__panel
    .flow-drawer__head
      = link_to desafio.name, challenge_path(desafio), class: "flow-drawer__title"
      -# El estado va en CHIP, como en `challenges/index` y en `challenges/show`:
      -# acá era la cuarta forma de dibujar lo mismo.
      -#
      -# Y va afuera del `__meta`, que no es prolijidad: ese span está atenuado
      -# (`opacity: .75`) y sobre el panel oscuro eso le come contraste al chip
      -# —medido en tema claro, el acento pasa de 2,80 a 2,09:1—. El contador sí
      -# puede ir atenuado: es texto gris de apoyo, no una marca de estado.
      .flow-drawer__estado-linea
        %span{ class: [chip_de_estado(desafio.status), "flow-drawer__estado"] }
          = t("flow.challenge_statuses.#{desafio.status}")
        - if setup
          -# «listos» y no un «de N» pelado: el pie de esta misma pantalla dice
          -# «Paso 3 de 9», que es una POSICIÓN, y dos «de 9» distintos en una
          -# pantalla se leen como el mismo número. Es la forma que ya tiene
          -# todo el resto de la app: «3 de 5 testeadas», «4 de 10 avanzan».
          %span.flow-drawer__meta
            = "#{setup.done_count} de #{setup.total} #{Flow::Texto.plural('listo', setup.done_count)}"
    %ul.menu.flow-drawer__steps
      - if setup
        - setup.steps.each_with_index do |paso, i|
          %li
            = link_to paso.path, class: ["flow-drawer__link", ("menu-active" if paso.key.to_s == actual.to_s)] do
              -# El ✓ reemplaza al número cuando el paso está hecho: dos
              -# marcas distintas en la misma columna se leen de un vistazo.
              %span.flow-drawer__num= paso.done? ? "✓" : i + 1
              %span.flow-drawer__body
                %span.flow-drawer__name= paso.label
                - if paso.hint.present?
                  %span.flow-drawer__hint= paso.hint
      - else
        - desafio.steps.order(:position).each_with_index do |paso, i|
          - estado = t("flow.statuses.#{paso.status}")
          %li
            = link_to challenge_step_path(desafio, paso), class: ["flow-drawer__link", ("menu-active" if @step&.id == paso.id)] do
              %span.flow-drawer__num= i + 1
              %span.flow-drawer__name= paso.name
              -# Un punto y no un chip —a 232px no entra el rótulo— así que el
              -# estado viaja en el `title`: un punto de color solo no dice
              -# nada. Tiene clase propia: vaciando un `badge`, cambiarle la
              -# variante a un chip le cambiaba el color al punto.
              %span{ class: punto_de_estado(paso.status), title: estado }
