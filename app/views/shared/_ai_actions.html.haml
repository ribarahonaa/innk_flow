-# Botones que disparan tareas de IA.
-#
-# Por defecto se ocultan cuando el modo efectivo es `human`: dentro de un
-# módulo, "solo personas" significa que ahí no interviene la IA.
-#
-# `always: true` es para las acciones de AUTORÍA —armar el flujo, proponer los
-# campos del formulario—. Ahí el modo no manda: define cómo se trabaja DENTRO
-# del desafío, no si su dueño puede pedir una mano para diseñarlo. Lo que
-# proponga siempre pasa por revisión humana.
- mode = local_assigns.fetch(:mode)
- always = local_assigns.fetch(:always, false)
- return if mode == "human" && !always

.ai-actions
  %span.ai-chip IA
  - if mode == "human"
    %span.muted La propuesta pasa por tu revisión.
  - else
    %span.muted= t("flow.ai_modes.#{mode}")
  -# A dónde responde cada pedido lo decide `marco_para_pedido_de_ia`: al marco
  -# de las propuestas cuando la respuesta es una sugerencia por revisar, y a
  -# la pantalla entera cuando el pedido ya aplicó el cambio.
  - actions.each do |action|
    - marco = marco_para_pedido_de_ia(action[:purpose], mode)
    -# Con `count_options` el pedido lleva un selector: cuántas quiere quien
    -# pide, en vez de una cantidad fija escondida en la vista.
    - if action[:count_options].present?
      = form_with url: challenge_ai_requests_path(challenge, purpose: action[:purpose], step_id: action[:step_id]),
                  method: :post, class: "ai-actions__form", data: { turbo_frame: marco } do
        = label_tag "count_#{action[:purpose]}", "Cuántas", class: "ai-actions__label"
        = select_tag :count, options_for_select(action[:count_options], action[:count]),
                     id: "count_#{action[:purpose]}", class: "ai-actions__count"
        = submit_tag action[:label], class: "btn btn-ghost btn-sm"
    - else
      = button_to action[:label],
                  challenge_ai_requests_path(challenge, purpose: action[:purpose], step_id: action[:step_id], idea_id: action[:idea_id], field_key: action[:field_key], count: action[:count]),
                  class: "btn btn-ghost btn-sm",
                  form: { data: { turbo_frame: marco } }
