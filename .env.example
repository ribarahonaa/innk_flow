# Proveedor de IA.
#
# `fixture` (default) corre sin red ni credenciales: respuestas deterministas
# desde spec/fixtures. `anthropic` usa la API de verdad — cada llamada cuesta.
FLOW_AI_PROVIDER=fixture

# Solo con FLOW_AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# FLOW_AI_MODEL=claude-opus-5

# Proveedor de EMBEDDINGS, aparte del de chat: son dos capacidades distintas y
# Anthropic no tiene la segunda. Sin declararlo se usa el de chat si sabe
# hacerlos, y si no el fixture (vectores deterministas, sin semántica).
# Con OpenAI (text-embedding-3-small, truncado a 1024 por parámetro):
# FLOW_EMBEDDINGS_PROVIDER=openai
# OPENAI_API_KEY=sk-...
#
# Con Voyage (1024 nativas):
# FLOW_EMBEDDINGS_PROVIDER=voyage
# VOYAGE_API_KEY=pa-...
#
# El modelo es opcional: cada proveedor tiene su default.
# FLOW_EMBEDDINGS_MODEL=text-embedding-3-small

# Proveedor de VOZ: transcribir la grabación de una mesa del taller. Es la
# TERCERA capacidad, aparte del chat y de los vectores, y ningún proveedor
# tiene las tres: Anthropic no transcribe, Voyage sólo vectoriza, y Deepgram
# sólo transcribe (su `complete` levanta ProviderUnsupported).
#
# Sin declararlo se usa el de chat si sabe transcribir, y si no el fixture.
#
# Se deja VACÍA a propósito: es lo que hace que `make spec` y `make screens`
# no facturen. Anthropic no sabe transcribir, así que la cascada cae al
# fixture y el recorrido de la grabación corre sin red. Declararla es elegir
# que cada corrida cueste plata.
# FLOW_SPEECH_PROVIDER=deepgram
# DEEPGRAM_API_KEY=...
#
# El modelo es opcional; el default del adapter es nova-3. La diarización va
# siempre activada, porque es el motivo por el que se transcribe.
# FLOW_SPEECH_MODEL=nova-3

# Ojo al agregar una variable nueva acá: `docker-compose.yml` NO tiene
# `env_file:`. Enumera el entorno de cada contenedor con `${VAR:-default}`,
# así que este archivo sirve nada más que para INTERPOLAR: una variable que
# el compose no nombra no llega a ningún proceso, por más que esté escrita.
# Las tres de voz ya están en el anchor `&app_env`; una cuarta hay que
# sumarla ahí también.
