# Proveedor de IA.
#
# `fixture` (default) corre sin red ni credenciales: respuestas deterministas
# desde spec/fixtures. `anthropic` usa la API de verdad — cada llamada cuesta.
FLOW_AI_PROVIDER=fixture

# Solo con FLOW_AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# FLOW_AI_MODEL=claude-opus-5

# Proveedor de EMBEDDINGS, aparte del de chat: son dos capacidades distintas y
# Anthropic no tiene la segunda. Sin declararlo se usa el de chat si sabe
# hacerlos, y si no el fixture (vectores deterministas, sin semántica).
# Con OpenAI (text-embedding-3-small, truncado a 1024 por parámetro):
# FLOW_EMBEDDINGS_PROVIDER=openai
# OPENAI_API_KEY=sk-...
#
# Con Voyage (1024 nativas):
# FLOW_EMBEDDINGS_PROVIDER=voyage
# VOYAGE_API_KEY=pa-...
#
# El modelo es opcional: cada proveedor tiene su default.
# FLOW_EMBEDDINGS_MODEL=text-embedding-3-small
